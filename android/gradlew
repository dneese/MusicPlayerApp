##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
#   Important for running:
#
#   (1) You need a POSIX-compliant shell to run this script. If your /bin/sh is
#       noncompliant, but you have some other compliant shell such as ksh or
#       bash, then run 'sh' pointing to that shell:
#
#           ksh android/gradlew
#
#   (2) Do not use a 'shebang' (e.g. #!/bin/sh) at the top of this file,
#       because it will be interpreted as a Gradle script.
#
##############################################################################

# Attempt to set APP_HOME

# Resolve links: $0 may be a link
app_path=$0

# Need this for daisy-chained symlinks.
while
    APP_HOME=${app_path%"${app_path##*/}"}  # leaves a trailing /; empty if no leading path
    [ -h "$app_path" ]
do
    ls=$(ls -ld "$app_path")
    link=${ls#*' -> '}
    case $link in             #(
      /*)   app_path=$link ;; #(
      *)    app_path=$APP_HOME$link ;;
    esac
done

# This is normally unused
# shellcheck disable=SC2034
APP_BASE_NAME=${0##*/}
APP_HOME=$( cd "${APP_HOME:-./}" && pwd -P ) || exit

# Add default JVM options here. You can also use JAVA_OPTS and GRADLE_OPTS to pass JVM options to this script.
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

# Use the maximum available, or set MAX_FD != -1 to use that value.
MAX_FD=maximum

warn () {
    echo "$*"
} >&2

die () {
    echo
    echo "$*"
    echo
    exit 1
} >&2

# OS specific support (must be 'true' or 'false').
cygwin=false
msys=false
darwin=false
nonstop=false
case "$( uname )" in                #(
  CYGWIN* )         cygwin=true  ;; #(
  Darwin* )         darwin=true  ;; #(
  MSYS* | MINGW* )  msys=true    ;; #(
  NONSTOP* )        nonstop=true ;;
esac

CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        # IBM's JDK on AIX uses strange locations for the executables
        JAVACMD=$JAVA_HOME/jre/sh/java
    else
        JAVACMD=$JAVA_HOME/bin/java
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
else
    JAVACMD=java
    if ! command -v java >/dev/null 2>&1
    then
        die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH.

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
fi

# Increase the maximum file descriptors if we can.
if ! "$cygwin" && ! "$darwin" && ! "$nonstop" ; then
    case $MAX_FD in #(
      max*)
        # In POSIX sh, ulimit -H -n is: the number of open files per process. The shell's hard limit.
        # In POSIX sh, ulimit -n is: the soft limit. Use the soft limit if we can.
        # In POSIX sh, ulimit -n -H is: the hard limit, but not a POSIX option for ulimit.
        # shellcheck disable=SC3045
        MAX_FD=$( ulimit -n -H ) || # Handle the warning.
            warn "Could not query hard file descriptor limit"
        ;;
    esac
    case $MAX_FD in  #(
      '' | soft) :;; #(
      *)
        # In POSIX sh, ulimit -n is: max number of file descriptors in the current shell.
        # In POSIX sh, ulimit -n -H is: hard limit, but not an option.
        # shellcheck disable=SC3045
        ulimit -n "$MAX_FD" || 
            warn "Could not set maximum file descriptor limit to $MAX_FD"
    esac
fi

# Collect all arguments for the java command, stacking in reverse order:
#   * args from the command line
#   * the main class name
#   * -classpath
#   * -D...appname settings
#   * --module-path (only if needed)
#   * DEFAULT_JVM_OPTS, JAVA_OPTS, and GRADLE_OPTS environment variables.

# For Cygwin or MSYS, switch paths to Windows format before running java
if "$cygwin" || "$msys" ; then
    APP_HOME=$( cygpath --path --mixed "$APP_HOME" )
    CLASSPATH=$( cygpath --path --mixed "$CLASSPATH" )

    JAVACMD=$( cygpath --unix "$JAVACMD" )

    # Now convert the arguments - kludge to limit ourselves to /bin/sh
    for arg do
        if
            case $arg in                                #(
              -*)   false ;;                            # not an option
              /?*)  t=${arg#/} t=/${t%%/*}              # looks like a POSIX filepath
                    [ -e "$t" ] ;;                      #(
              *)    false ;;
            esac
        then
            arg=$( cygpath --path --ignore --mixed "$arg" )
        fi
        # Roll the args list around exactly as many times as the number of
        # args, so each arg winds up back in the position where it started, but
        # possibly modified.
        #
        # NB: a `for` loop captures its iteration list before the loop body,
        # so the ability to modify the argument list except by `set --` is not
        # available. Use `while` and a fifo for maximum compatibility.
        args="$args $arg"
    done
fi

# Collect the arguments in a variable that can be used for `set`.
# This avoids interleaving of stdout and stderr if the shell has
# different `set -x` settings.
args=

# Save the specified JVM options and main class name
while [ $# -gt 0 ]; do
    arg="$1"
    shift

    # Handle suggestions from environment variables.
    case $arg in             #(
      --parallel)   ;; #(
      --no-parallel) ;; #(
      --daemon)     ;; #(
      --stop-daemon) ;; #(
      --stacktrace)  args="$args $arg";; #(
      --info)       args="$args $arg";; #(
      --debug)      args="$args $arg";; #(
      -P*)          args="$args $arg";; #(
      -D*)          args="$args $arg";; #(
      -X*)          args="$args $arg";; #(
      -cp)          args="$args $arg";; #(
      -classpath)   args="$args $arg";; #(
      -*)           args="$args $arg";; #(
      *)            break;;
    esac
done

# Split up the JVM_OPTS And GRADLE_OPTS values into an array, following the
# shell quoting and substitution rules
function splitJvmOpts {
    JVM_OPTS=$1
    if [ -n "$JVM_OPTS" ]; then
        # Use eval to set IFS to space and perform the split.
        # We cannot use 'set -- $JVM_OPTS' because that would not quote
        # spaces within options.
        eval "set -- $JVM_OPTS"
        for opt; do
            args="$args $opt"
        done
        # Reset IFS to its default value
        IFS=' 
'
    fi
}
splitJvmOpts "$DEFAULT_JVM_OPTS"
splitJvmOpts "$JAVA_OPTS"
splitJvmOpts "$GRADLE_OPTS"

# Handle the arguments that must be preserved.
while [ $# -gt 0 ]; do
    args="$args $1"
    shift
done

# Save the main class name.
MAIN_CLASS_NAME=org.gradle.wrapper.GradleWrapperMain

# Make sure the classpath separator is a colon, not a semicolon.
# In POSIX sh, CLASSPATH can't be set to a list of paths separated by colons.
# The only solution is to construct a single string with colons.
# shellcheck disable=SC2155
export CLASSPATH="$CLASSPATH"

# Make a copy so we can modify it
args_copy="$args"

# Add the main class name, then the arguments.
args="$MAIN_CLASS_NAME $args_copy"

# Determine the Java command to use to start the JVM.
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        # IBM's JDK on AIX uses strange locations for the executables
        JAVACMD=$JAVA_HOME/jre/sh/java
    else
        JAVACMD=$JAVA_HOME/bin/java
    fi
    if [ ! -x "$JAVACMD" ] ; then
        die "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
else
    JAVACMD=java
    if ! command -v java >/dev/null 2>&1
    then
        die "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH.

Please set the JAVA_HOME variable in your environment to match the
location of your Java installation."
    fi
fi

exec "$JAVACMD" $args
